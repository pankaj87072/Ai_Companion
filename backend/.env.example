# Pick ONE provider: openai | anthropic | google
AI_PROVIDER=openai

# Paste the API key for whichever provider you picked above.
AI_API_KEY=

# Optional -- leave blank to use a sensible default for the chosen provider
# (openai -> gpt-4o-mini, anthropic -> claude-3-5-sonnet-20241022, google -> gemini-1.5-flash)
AI_MODEL=

# Optional, "openai" provider only -- set this to use any OpenAI-compatible endpoint
# instead of api.openai.com (OpenRouter, Groq, Together, a local Ollama/vLLM server, etc.)
AI_BASE_URL=

DATABASE_URL=sqlite:///./companion.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
